{
  "name": "@centripetal/identity",
  "version": "0.1.0",
  "description": "Universal identity for Centripetal apps: SSO buttons, memberships, magic-link. Federated — no central auth broker in any login path.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "link-by-email.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2",
    "react": ">=18"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "typescript": "^5.5.4"
  }
}
